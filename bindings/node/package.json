{
  "name": "simdriver",
  "version": "0.1.2",
  "description": "Embed a live iOS simulator in your app: frames + touch input (Node, Bun, Electron main)",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "helpers",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-LICENSE",
    "simdriver-controls.md"
  ],
  "scripts": {
    "prepack": "node scripts/prepare-package.js",
    "build:debug": "napi build --platform --no-js --dts native.d.ts && node scripts/copy-helpers.js",
    "build": "napi build --platform --release --no-js --dts native.d.ts && node scripts/copy-helpers.js",
    "test": "bun test --timeout 30000",
    "test:node": "node --import tsx test/node.test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.0",
    "tsx": "^4"
  },
  "napi": {
    "name": "simdriver"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ios",
    "simulator",
    "automation",
    "macos",
    "electron"
  ]
}
